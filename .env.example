# ============================================================
# DentPilot Admin — متغيّرات البيئة
# انسخ هذا الملف إلى .env للتطوير المحلي، وأضف نفس القيم في
# إعدادات Environment Variables على Vercel للإنتاج.
# ============================================================

# سرّ توقيع رموز الجلسة (إلزامي في الإنتاج). ولّد قيمة عشوائية طويلة:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ----- قاعدة البيانات Supabase (للإنتاج) -----
# اترك المتغيّرين فارغين للتطوير المحلي؛ عندها يُستخدم ملف .data/db.json تلقائياً.
SUPABASE_URL=
# مفتاح service_role (سرّي — يُوضع على الخادم فقط، لا يُرسل للمتصفّح أبداً)
SUPABASE_SERVICE_KEY=

# ----- إعدادات اختيارية -----
# لحظة إعادة ضبط العدّاد اليومي بالدقائق عن UTC. الافتراضي 180 = UTC+3 (توقيت الخليج).
DAY_RESET_OFFSET_MINUTES=180

# منفذ خادم التطوير المحلي
PORT=3000

# صفحة مولّد أكواد الوكيل العامة (agent-generator.html) — تحكّم بلا قاعدة بيانات:
# AGENT_PAGE_ENABLED=false لإيقاف الخدمة مؤقتاً (الافتراضي: مفعّلة).
AGENT_PAGE_ENABLED=true
# الحد اليومي الإجمالي لعدد الأكواد من الصفحة العامة (0 = بلا حد).
AGENT_PAGE_DAILY_LIMIT=0
